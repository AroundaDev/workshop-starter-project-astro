---
/*
 * Головна сторінка (/). Макет: design/nora-landing-motion.html.
 * Секції додаємо по одній.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/sections/Header.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import LogoStrip from '../components/sections/LogoStrip.astro';
import ManifestoSection from '../components/sections/ManifestoSection.astro';
import HowSection from '../components/sections/HowSection.astro';
import FeaturesSection from '../components/sections/FeaturesSection.astro';
import ReviewsSection from '../components/sections/ReviewsSection.astro';
import PricingSection from '../components/sections/PricingSection.astro';
import FaqSection from '../components/sections/FaqSection.astro';
---

<BaseLayout
	title="Nora — AI receptionist for service businesses"
	description="Nora answers your business calls and texts 24/7, books appointments into your calendar and follows up with anyone you missed."
>
	<Header />
	<main id="top">
		<HeroSection />
		<LogoStrip />
		<ManifestoSection />
		<HowSection />
		<FeaturesSection />
		<ReviewsSection />
		<PricingSection />
		<FaqSection />
	</main>
</BaseLayout>
