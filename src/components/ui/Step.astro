---
/* Крок інструкції на вертикальній лінії. active: поточний, решта приглушені. */
interface Props {
	when: string;
	title: string;
	active?: boolean;
	state?: 'hover' | 'focus';
}

const { when, title, active = false, state } = Astro.props;
---

<article class:list={['step', { 'is-active': active }]} data-step-item data-state={state}>
	<span class="text-label">{when}</span>
	<h3><button type="button" aria-pressed={active ? 'true' : 'false'}>{title}</button></h3>
	<p><slot /></p>
</article>

<style>
	.step {
		position: relative;
		display: grid;
		gap: var(--space-8);
		align-items: baseline;
		padding-block: var(--space-24);
		border-top: var(--border-width) solid var(--color-border-default);
		opacity: var(--opacity-step-inactive);
		transition: opacity var(--duration-base) var(--ease-soft);
	}

	.step:last-child { border-bottom: var(--border-width) solid var(--color-border-default); }
	.step:hover,
	.step[data-state="hover"] { opacity: var(--opacity-step-hover); }
	.step.is-active,
	.step:focus-within,
	.step[data-state="focus"] { opacity: 1; }

	/* крапка на лінії ліворуч */
	.step::before {
		content: "";
		position: absolute;
		top: calc(var(--space-24) + var(--space-4));
		left: calc(-1 * var(--space-24) - var(--space-4));
		width: var(--size-step-dot);
		height: var(--size-step-dot);
		border-radius: 50%;
		background: var(--color-bg-page);
		box-shadow: inset 0 0 0 var(--border-width) var(--color-border-default);
		transition: background-color var(--duration-base) var(--ease-soft);
	}

	.step.is-active::before {
		background: var(--color-text-primary);
		box-shadow: none;
	}

	h3 { font-size: var(--font-size-18); }

	/* натискати можна весь рядок */
	button {
		text-align: start;
		font-weight: inherit;
		letter-spacing: inherit;
	}

	button::after {
		content: "";
		position: absolute;
		inset: 0;
	}

	p {
		font-size: var(--font-size-15);
		color: var(--color-text-secondary);
	}

	@media (min-width: 768px) {
		.step {
			grid-template-columns: var(--space-96) minmax(0, 1fr) minmax(0, 1.2fr);
			gap: var(--space-24);
			padding-block: var(--space-48);
		}

		.step::before { top: calc(var(--space-48) + var(--space-4)); }
	}
</style>
