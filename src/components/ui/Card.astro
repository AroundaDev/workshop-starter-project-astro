---
/*
 * Картка/плитка без тіні.
 * surface: сіра плитка, raised: світла картка інтерфейсу, dark: темна,
 * blush: виділена, glass: скляна панель поверх фото.
 * lift: трохи піднімається при наведенні.
 */
interface Props {
	variant?: 'surface' | 'raised' | 'dark' | 'blush' | 'glass';
	as?: 'div' | 'article' | 'li';
	lift?: boolean;
	class?: string;
	'data-state'?: 'hover';
}

const { variant = 'surface', as: Element = 'div', lift = false, class: className, 'data-state': state } = Astro.props;
---

<Element data-state={state} class:list={['card', `card--${variant}`, { 'card--lift': lift, 'is-dark': variant === 'dark' }, className]}>
	<slot />
</Element>

<style>
	.card {
		position: relative;
		min-width: 0;
		padding: var(--space-24);
		overflow: hidden;
		border-radius: var(--radius-8);
	}

	@media (min-width: 768px) {
		.card { padding: var(--space-32); }
	}

	.card--surface { background: var(--color-bg-surface); }
	.card--raised { background: var(--color-bg-raised); }
	.card--blush { background: var(--color-blush); }

	.card--glass {
		background: var(--color-bg-glass-panel);
		-webkit-backdrop-filter: blur(var(--blur-panel));
		backdrop-filter: blur(var(--blur-panel));
	}

	.card--lift { transition: transform var(--duration-base) var(--ease-out); }

.card--lift[data-state="hover"] { transform: translateY(calc(-1 * var(--space-4))); }

	@media (hover: hover) and (pointer: fine) {
		.card--lift:hover { transform: translateY(calc(-1 * var(--space-4))); }
	}
</style>
