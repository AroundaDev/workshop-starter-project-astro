---
/*
 * Card — a block with a title and text.
 *
 * Usage:
 *   <Card title="Fast">Pages load in under a second.</Card>
 *
 * Props:
 *   title: the card heading
 * The text inside the tag goes into <slot />.
 */
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<article class="card">
	<h3 class="title">{title}</h3>
	<div class="text"><slot /></div>
</article>

<style>
	.card {
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
		padding: var(--space-24);
		border: var(--border-width) solid var(--color-border-card);
		border-radius: var(--radius-16);
		background-color: var(--color-bg-subtle);
	}

	.title {
		color: var(--color-text-strong);
	}

	.text {
		color: var(--color-text-secondary);
		font-size: var(--font-size-14);
		line-height: var(--line-height-130);
		letter-spacing: var(--letter-spacing-minus-1);
	}
</style>
