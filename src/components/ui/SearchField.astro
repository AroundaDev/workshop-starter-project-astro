---
/*
 * SearchField — a round search input with a ⌘ shortcut button.
 * Figma: Search Field (8124:1139).
 *
 * Usage:
 *   <SearchField placeholder="Search" />
 *
 * Props:
 *   placeholder: grey hint text inside the field
 */
import { Image } from 'astro:assets';
import searchIcon from '../../assets/icons/search.svg';
import commandIcon from '../../assets/icons/command.svg';

interface Props {
	placeholder?: string;
	class?: string;
}

const { placeholder = 'Search', class: className } = Astro.props;
---

<label class:list={['search', className]}>
	<Image class="search-icon" src={searchIcon} alt="" />
	<input class="input text-body-xl-regular" type="search" placeholder={placeholder} aria-label={placeholder} />
	<span class="shortcut" aria-hidden="true">
		<Image src={commandIcon} alt="" />
	</span>
</label>

<style>
	.search {
		display: flex;
		align-items: center;
		gap: var(--space-10);
		min-inline-size: 0;
		padding: var(--space-6);
		padding-inline-start: var(--space-16);
		border: var(--border-width) solid var(--color-border-default);
		border-radius: var(--radius-999);
		background-color: var(--color-bg-surface);
		cursor: text;
	}

	.search:focus-within {
		border-color: var(--color-border-divider);
	}

	.search-icon {
		flex-shrink: 0;
	}

	.input {
		flex: 1;
		min-inline-size: 0;
		border: none;
		background: none;
		color: var(--color-text-primary);
		outline: none;
	}

	.input::placeholder {
		color: var(--color-text-secondary);
	}

	.shortcut {
		display: inline-flex;
		flex-shrink: 0;
		padding: var(--space-12);
		border-radius: var(--radius-999);
		background-color: var(--color-text-heading);
	}
</style>
