---
/* Сповіщення в списку: іконка, подія, уточнення. */
import Icon, { type IconName } from './Icon.astro';

interface Props {
	icon: IconName;
	title: string;
	note: string;
}

const { icon, title, note } = Astro.props;
---

<div class="notif">
	<Icon name={icon} size={20} />
	<span>{title}<small>{note}</small></span>
</div>

<style>
	.notif {
		display: flex;
		align-items: flex-start;
		gap: var(--space-12);
		padding-block: var(--space-8);
		border-top: var(--border-width) solid var(--color-border-default);
		font-size: var(--font-size-14);
		line-height: var(--line-height-heading);
	}

	.notif:first-of-type { border-top: 0; }

	small {
		display: block;
		font-size: var(--font-size-12);
		color: var(--color-text-secondary);
	}
</style>
