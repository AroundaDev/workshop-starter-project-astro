---
/*
 * IconButton — a round 52 × 52 button with an icon.
 * Figma: Icon Button (8133:361). The icon file from Figma already
 * contains the white circle, the border and (for notifications) the unread dot.
 *
 * Usage:
 *   <IconButton icon={bellIcon} label="Notifications" />
 *
 * Props:
 *   icon:  imported icon file
 *   label: what the button does (read aloud by screen readers)
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	icon: ImageMetadata;
	label: string;
	class?: string;
}

const { icon, label, class: className } = Astro.props;
---

<button class:list={['icon-button', className]} type="button" aria-label={label}>
	<Image src={icon} alt="" />
</button>

<style>
	.icon-button {
		display: inline-flex;
		flex-shrink: 0;
		inline-size: var(--size-icon-button);
		block-size: var(--size-icon-button);
		border-radius: var(--radius-999);
	}
</style>
