---
/*
 * ReportCard — an airline benchmark report card.
 * Figma: Report Card (8132:179).
 *
 * Usage:
 *   <ReportCard
 *     airline="Singapore Airlines"
 *     reportType="Airline Benchmark Report"
 *     cover={coverImage} coverAlt="Flight attendant serving a meal"
 *     logo={logoImage} logoWidth={20} logoHeight={25}
 *     nps="8.4 / 10"
 *     updated="Updated Sep 24, 2026"
 *     cabins="Short / Medium / Long haul"
 *     keyAreas={['Service Flow', 'Culinary', 'Partnerships']}
 *   />
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Badge from './Badge.astro';
import indicatorCabins from '../../assets/icons/indicator-cabins.svg';
import indicatorKeyAreas from '../../assets/icons/indicator-key-areas.svg';
import dividerLine from '../../assets/icons/divider.svg';
import separatorDot from '../../assets/icons/separator.svg';

interface Props {
	airline: string;
	reportType: string;
	cover: ImageMetadata;
	coverAlt: string;
	logo: ImageMetadata;
	logoWidth: number;
	logoHeight: number;
	nps: string;
	updated: string;
	cabins: string;
	keyAreas: string[];
}

const { airline, reportType, cover, coverAlt, logo, logoWidth, logoHeight, nps, updated, cabins, keyAreas } = Astro.props;
---

<article class="card">
	<div class="cover">
		<Image class="cover-image" src={cover} alt={coverAlt} widths={[420, 840]} sizes="(min-width: 1440px) 420px, (min-width: 768px) 50vw, 100vw" />
		<Badge class="nps" variant="nps">{nps}</Badge>
	</div>

	<header class="header">
		<div class="airline">
			<span class="logo">
				<Image
					src={logo}
					alt={`${airline} logo`}
					width={logoWidth}
					height={logoHeight}
					densities={[1, 2]}
					style={`--logo-width: ${logoWidth}px; --logo-height: ${logoHeight}px`}
				/>
			</span>
			<div class="airline-info">
				<h3 class="name text-title-card">{airline}</h3>
				<p class="type text-body-m-regular-tight">{reportType}</p>
			</div>
		</div>
		<Badge variant="updated">{updated}</Badge>
	</header>

	<dl class="details">
		<div class="row">
			<span class="indicator"><Image src={indicatorCabins} alt="" /></span>
			<div class="row-content">
				<dt class="label text-label-m-medium">Cabins</dt>
				<dd class="value text-body-m-regular">{cabins}</dd>
			</div>
		</div>
		<Image class="divider" src={dividerLine} alt="" />
		<div class="row">
			<span class="indicator"><Image src={indicatorKeyAreas} alt="" /></span>
			<div class="row-content">
				<dt class="label text-label-m-medium">Key Areas</dt>
				<dd class="value tags text-body-m-regular">
					{keyAreas.map((area, index) => (
						<>
							{index > 0 && <Image src={separatorDot} alt="" />}
							<span>{area}</span>
						</>
					))}
				</dd>
			</div>
		</div>
	</dl>
</article>

<style>
	.card {
		display: flex;
		flex-direction: column;
		gap: var(--space-16);
		min-inline-size: 0;
		padding: var(--space-10);
		border: var(--border-width) solid var(--color-border-card);
		border-radius: var(--radius-20);
		/* Figma: color/bg/subtle with 20% fill opacity */
		background-color: color-mix(in srgb, var(--color-bg-subtle) 20%, transparent);
	}

	/* ---------- Cover photo ---------- */
	.cover {
		position: relative;
		overflow: hidden;
		aspect-ratio: 408 / 151;
		border: var(--border-width) solid var(--color-border-card);
		border-radius: var(--radius-16);
		background-color: var(--color-bg-image-placeholder);
	}

	.cover-image {
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
	}

	.cover :global(.nps) {
		position: absolute;
		inset-block-start: var(--space-20);
		inset-inline-start: var(--space-14);
	}

	/* ---------- Header: logo, name, "Updated" ---------- */
	.header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: var(--space-8);
	}

	.airline {
		display: flex;
		align-items: center;
		flex: 1;
		gap: var(--space-8);
		min-inline-size: 0;
	}

	.logo {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		inline-size: calc(var(--space-32) + var(--space-6));
		block-size: calc(var(--space-32) + var(--space-6));
		padding: var(--space-6);
		overflow: hidden;
		border: var(--border-width) solid var(--color-bg-surface);
		border-radius: var(--radius-12);
		background-color: var(--color-text-strong);
	}

	/* In Figma the logo can be wider than the box (British Airways: 32 × 20) */
	.logo :global(img) {
		flex-shrink: 0;
		inline-size: var(--logo-width);
		block-size: var(--logo-height);
		max-inline-size: none;
		object-fit: cover;
	}

	.airline-info {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		min-inline-size: 0;
	}

	.name {
		color: var(--color-text-primary);
	}

	.type {
		color: var(--color-text-tertiary);
	}

	/* ---------- Details: Cabins and Key Areas ---------- */
	.details {
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
		padding: var(--space-10) var(--space-16);
		border: var(--border-width) solid var(--color-border-subtle);
		border-radius: var(--radius-10);
		background-color: var(--color-bg-surface);
	}

	.row {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}

	/* The coloured line on the left; the Figma file is a bit larger than its box */
	.indicator {
		position: relative;
		flex-shrink: 0;
		inline-size: var(--space-8);
		block-size: calc(var(--space-24) + var(--space-2));
	}

	.indicator :global(img) {
		position: absolute;
		inset-block-start: 50%;
		inset-inline-start: 50%;
		transform: translate(-50%, -50%);
		max-inline-size: none;
	}

	.row-content {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		flex: 1;
		flex-wrap: wrap;
		column-gap: var(--space-12);
		row-gap: var(--space-4);
		min-inline-size: 0;
	}

	.label {
		color: var(--color-text-label);
	}

	.value {
		color: var(--color-text-primary);
		text-align: end;
	}

	.tags {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		flex-wrap: wrap;
		gap: var(--space-6);
	}

	.divider {
		inline-size: 100%;
		block-size: var(--border-width);
	}
</style>
