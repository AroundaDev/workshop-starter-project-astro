---
/*
 * Кнопка-пігулка. З href це посилання, без нього кнопка.
 * <Button href="#pricing" arrow>Start free trial</Button>
 * <Button variant="outline" size="sm" full>Log in</Button>
 */
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';

type Props = (HTMLAttributes<'a'> | HTMLAttributes<'button'>) & {
	variant?: 'primary' | 'quiet' | 'outline';
	size?: 'sm' | 'md';
	arrow?: boolean;
	full?: boolean;
	disabled?: boolean;
};

const { variant = 'primary', size = 'md', arrow = false, full = false, disabled = false, class: className, ...rest } = Astro.props;
// вимкнене посилання стає кнопкою, щоб по ньому не можна було перейти
const isLink = !disabled && 'href' in rest && Boolean(rest.href);
if (disabled && 'href' in rest) delete rest.href;
const Tag = isLink ? 'a' : 'button';
const type = isLink ? undefined : ((rest as HTMLAttributes<'button'>).type ?? 'button');
---

<Tag {...rest} type={type} disabled={isLink ? undefined : disabled} class:list={['btn', `btn--${variant}`, `btn--${size}`, { 'btn--arrow': arrow, 'btn--full': full }, className]}>
	<slot />
	{
		arrow && (
			<span class="btn__circle">
				<Icon name="arrow-up-right" />
				<Icon name="arrow-up-right" class="btn__icon-next" />
			</span>
		)
	}
</Tag>

<style>
	.btn {
		--btn-height: var(--size-control-md);
		position: relative;
		isolation: isolate;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-8);
		height: var(--btn-height);
		padding-inline: var(--space-24);
		border: 0;
		border-radius: var(--radius-999);
		font-family: var(--font-family-text);
		font-size: var(--font-size-15);
		font-weight: var(--font-weight-medium);
		line-height: var(--line-height-none);
		text-decoration: none;
		white-space: nowrap;
		cursor: pointer;
		transition: transform var(--duration-fast) var(--ease-out);
	}

	.btn:active:not(:disabled),
	.btn[data-state="active"] { transform: scale(var(--scale-pressed)); }

	.btn:disabled {
		opacity: var(--opacity-disabled);
		box-shadow: none;
		cursor: default;
	}

	.btn--sm {
		--btn-height: var(--size-control-sm);
		padding-inline: var(--space-16);
		font-size: var(--font-size-14);
	}

	.btn--full { width: 100%; }

	/* шар, що з'являється при наведенні */
	.btn::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		border-radius: inherit;
		opacity: 0;
		transition: opacity var(--duration-fast) var(--ease-soft);
	}

	.btn--primary {
		color: var(--color-text-on-ink);
		background: var(--gradient-button);
		box-shadow: var(--shadow-button);
	}

	.btn--primary::after { background: var(--color-white); }
	.btn--primary:hover:not(:disabled)::after,
	.btn--primary[data-state="hover"]::after { opacity: var(--opacity-button-hover); }

	.btn--quiet {
		color: var(--color-ink);
		background: var(--color-white);
	}

	.btn--quiet::after { box-shadow: inset 0 0 0 var(--border-width) var(--color-border-default); }
	.btn--quiet:hover:not(:disabled)::after,
	.btn--quiet[data-state="hover"]::after { opacity: 1; }

	.btn--outline {
		color: var(--color-text-primary);
		background: transparent;
		box-shadow: inset 0 0 0 var(--border-width) var(--color-border-strong);
	}

	.btn--outline::after { box-shadow: inset 0 0 0 var(--border-width) var(--color-text-primary); }
	.btn--outline:hover:not(:disabled)::after,
	.btn--outline[data-state="hover"]::after { opacity: 1; }

	/* outline тримає обводку через box-shadow, тому повертаємо її у вимкненому стані */
	.btn--outline:disabled { box-shadow: inset 0 0 0 var(--border-width) var(--color-border-strong); }

	.btn--arrow {
		gap: var(--space-12);
		padding-inline-end: var(--space-6);
	}

	.btn__circle {
		position: relative;
		display: grid;
		place-items: center;
		width: calc(var(--btn-height) - var(--space-12));
		aspect-ratio: 1;
		overflow: hidden;
		border-radius: 50%;
		color: var(--color-ink);
		background: var(--color-white);
	}

	/* стрілка «вилітає» й повертається з іншого боку */
	.btn__circle :global(.icon) { transition: transform var(--duration-base) var(--ease-out); }
	.btn__circle :global(.btn__icon-next) { position: absolute; transform: translate(-160%, 160%); }

	@media (hover: hover) and (pointer: fine) {
		.btn--arrow:hover:not(:disabled) .btn__circle :global(.icon:first-child) { transform: translate(160%, -160%); }
		.btn--arrow:hover:not(:disabled) .btn__circle :global(.btn__icon-next) { transform: none; }
	}

	.btn--arrow[data-state="hover"] .btn__circle :global(.icon:first-child) { transform: translate(160%, -160%); }
	.btn--arrow[data-state="hover"] .btn__circle :global(.btn__icon-next) { transform: none; }
</style>
