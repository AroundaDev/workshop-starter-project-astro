---
/* Репліка в розшифровці дзвінка. nora: відповідь асистента. */
interface Props {
	who: string;
	nora?: boolean;
}

const { who, nora = false } = Astro.props;
---

<div class:list={['line', { 'line--nora': nora }]}>
	<span class="line__who">{who}</span>
	<span><slot /></span>
</div>

<style>
	.line {
		display: grid;
		grid-template-columns: var(--space-64) minmax(0, 1fr);
		gap: var(--space-8);
		font-size: var(--font-size-14);
		line-height: var(--line-height-lead);
	}

	.line__who {
		padding-block-start: var(--space-2);
		font-family: var(--font-family-mono);
		font-size: var(--font-size-11);
		font-weight: var(--font-weight-medium);
		letter-spacing: var(--letter-spacing-caps);
		text-transform: uppercase;
		color: var(--color-text-secondary);
	}

	.line--nora .line__who { color: var(--color-text-primary); }
</style>
