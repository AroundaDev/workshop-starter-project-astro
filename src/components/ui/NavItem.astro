---
/*
 * NavItem — a round sidebar menu item with an icon.
 * Figma: Nav Item (8133:304).
 *
 * Usage:
 *   <NavItem href="/" icon={dashboardIcon} label="Dashboard" variant="active" />
 *
 * Props:
 *   href:    link address
 *   icon:    imported 24 × 24 icon file
 *   label:   item name (read aloud by screen readers, shown on hover)
 *   variant: "ghost" (no background, default), "active" (dark, current page), "filled" (white)
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	href: string;
	icon: ImageMetadata;
	label: string;
	variant?: 'ghost' | 'active' | 'filled';
}

const { href, icon, label, variant = 'ghost' } = Astro.props;
---

<a
	class:list={['nav-item', variant]}
	href={href}
	aria-label={label}
	title={label}
	aria-current={variant === 'active' ? 'page' : undefined}
>
	<Image src={icon} alt="" />
</a>

<style>
	.nav-item {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		inline-size: var(--size-icon-button);
		block-size: var(--size-icon-button);
		padding: var(--space-14);
		border-radius: var(--radius-999);
	}

	.nav-item:hover:not(.active) {
		background-color: var(--color-bg-surface);
	}

	/* Figma uses a dark gradient here; it has no colour variable yet, so we use the solid heading colour */
	.active {
		background-color: var(--color-text-heading);
	}

	.filled {
		background-color: var(--color-bg-surface);
	}
</style>
