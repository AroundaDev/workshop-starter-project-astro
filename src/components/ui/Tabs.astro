---
/*
 * Перемикач варіантів. segmented: спільна підкладка (Monthly / Yearly),
 * pills: окремі пігулки з крапкою (список можливостей).
 * Після вибору надсилає подію "tabchange" з { index }.
 */
interface Props {
	label: string;
	items: { label: string; badge?: string; disabled?: boolean; state?: 'hover' | 'focus' }[];
	selected?: number;
	variant?: 'segmented' | 'pills';
}

const { label, items, selected = 0, variant = 'segmented' } = Astro.props;
---

<div class:list={['tabs', `tabs--${variant}`]} role="group" aria-label={label} data-tabs>
	{
		items.map((item, index) => (
			<button type="button" class="tab" aria-pressed={index === selected ? 'true' : 'false'} disabled={item.disabled} data-state={item.state}>
				<span>{item.label}</span>
				{item.badge && <span class="tab__badge">{item.badge}</span>}
				{variant === 'pills' && <span class="tab__dot" aria-hidden="true" />}
			</button>
		))
	}
</div>

<script>
	document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((group) => {
		const tabs = [...group.querySelectorAll<HTMLButtonElement>('.tab')];
		tabs.forEach((tab, index) =>
			tab.addEventListener('click', () => {
				tabs.forEach((other) => other.setAttribute('aria-pressed', String(other === tab)));
				group.dispatchEvent(new CustomEvent('tabchange', { detail: { index }, bubbles: true }));
			}),
		);
	});
</script>

<style>
	.tabs {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
		max-width: 100%;
	}

	.tabs--segmented {
		display: inline-flex;
		padding: var(--space-4);
		border-radius: var(--radius-24);
		background: var(--color-bg-surface);
	}

	.tabs--pills { gap: var(--space-8); }

	.tab {
		display: inline-flex;
		align-items: center;
		gap: var(--space-8);
		height: var(--size-control-sm);
		padding-inline: var(--space-16);
		border-radius: var(--radius-999);
		font-size: var(--font-size-14);
		white-space: nowrap;
		color: var(--color-text-secondary);
		transition:
			color var(--duration-base) var(--ease-out),
			background-color var(--duration-base) var(--ease-out);
	}

	.tabs--pills .tab {
		height: var(--size-control-lg);
		padding-inline: var(--space-24);
		background: var(--color-bg-surface);
	}

	.tab:hover:enabled,
	.tab[data-state="hover"] { color: var(--color-text-primary); }

	.tab[aria-pressed="true"],
	.tabs--pills .tab[aria-pressed="true"] {
		color: var(--color-ink);
		background: var(--color-white);
	}

	.tab:disabled {
		opacity: var(--opacity-disabled);
		cursor: default;
	}

	.tab__badge {
		padding: var(--space-4) var(--space-8);
		border-radius: var(--radius-999);
		font-family: var(--font-family-mono);
		font-size: var(--font-size-11);
		line-height: var(--line-height-none);
		color: var(--color-dark-text);
		background: var(--color-dark-bg);
	}

	.tab__dot {
		width: var(--size-dot);
		height: var(--size-dot);
		border-radius: 50%;
		background: var(--color-ink);
		opacity: 0;
		transition: opacity var(--duration-base) var(--ease-out);
	}

	.tab[aria-pressed="true"] .tab__dot { opacity: 1; }
</style>
