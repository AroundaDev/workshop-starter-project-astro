---
/* Текстове посилання. nav: без підкреслення (меню, футер); inline: у тексті. */
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
	variant?: 'nav' | 'inline';
}

const { variant = 'nav', class: className, ...rest } = Astro.props;
---

<a {...rest} class:list={['link', `link--${variant}`, className]}><slot /></a>

<style>
	.link {
		font-size: var(--font-size-14);
		color: var(--color-text-primary);
		transition: opacity var(--duration-fast) var(--ease-soft);
	}

	.link--nav { text-decoration: none; }

	.link--inline {
		font-size: inherit;
		text-decoration-thickness: var(--border-width);
		text-underline-offset: var(--space-4);
	}

	.link:hover,
	.link[data-state="hover"] { opacity: var(--opacity-link-hover); }

	.link[aria-current="page"] {
		text-decoration: underline;
		text-underline-offset: var(--space-6);
	}
</style>
