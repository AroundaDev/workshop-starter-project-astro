---
/*
 * Badge — a small label.
 * Figma: Badge/Updated (8132:65), Badge/NPS (8132:69).
 *
 * Usage:
 *   <Badge>New</Badge>                              → yellow pill
 *   <Badge variant="updated">Updated Sep 24</Badge> → green status in the card header
 *   <Badge variant="nps">8.4 / 10</Badge>           → NPS score with a dot and the "NPS:" prefix
 *
 * Props:
 *   variant: "default", "updated" or "nps"
 */
import { Image } from 'astro:assets';
import dotIcon from '../../assets/icons/dot.svg';

interface Props {
	variant?: 'default' | 'updated' | 'nps';
	class?: string;
}

const { variant = 'default', class: className } = Astro.props;
---

<span class:list={['badge', variant, className]}>
	{variant === 'nps' && <Image src={dotIcon} alt="" />}
	<span class:list={[variant === 'updated' ? 'text-label-s-medium' : 'text-caption-badge']}>
		{variant === 'nps' && <b class="text-caption-badge-bold">NPS: </b>}<slot />
	</span>
</span>

<style>
	.badge {
		display: inline-flex;
		align-items: center;
		white-space: nowrap;
	}

	.default {
		padding: var(--space-4) var(--space-8);
		border-radius: var(--radius-999);
		background-color: var(--color-bg-badge);
		color: var(--color-text-heading);
	}

	.updated {
		padding: var(--space-6) var(--space-10);
		border: var(--border-width) solid var(--color-border-success);
		border-radius: var(--radius-10);
		background-color: var(--color-bg-success-soft);
		color: var(--color-text-success);
	}

	.nps {
		gap: var(--space-4);
		padding: var(--space-8);
		border-radius: var(--radius-999);
		background-color: var(--color-bg-accent-soft);
		color: var(--color-text-strong);
	}
</style>
