---
/* Перемикач увімк/вимк. label читають скрінрідери. Надсилає подію "switchchange". */
interface Props {
	label: string;
	checked?: boolean;
	disabled?: boolean;
}

const { label, checked = false, disabled = false } = Astro.props;
---

<button type="button" role="switch" class="switch" aria-checked={checked ? 'true' : 'false'} aria-label={label} disabled={disabled} data-switch>
	<span class="switch__knob"></span>
</button>

<script>
	document.querySelectorAll<HTMLButtonElement>('[data-switch]').forEach((button) =>
		button.addEventListener('click', () => {
			const checked = button.getAttribute('aria-checked') !== 'true';
			button.setAttribute('aria-checked', String(checked));
			button.dispatchEvent(new CustomEvent('switchchange', { detail: { checked }, bubbles: true }));
		}),
	);
</script>

<style>
	.switch {
		position: relative;
		flex: none;
		width: var(--size-switch-width);
		height: var(--size-switch-height);
		border-radius: var(--radius-999);
		background: var(--color-border-default);
		transition: background-color var(--duration-base) var(--ease-soft);
	}

	.switch__knob {
		position: absolute;
		top: var(--space-2);
		left: var(--space-2);
		width: var(--size-switch-knob);
		height: var(--size-switch-knob);
		border-radius: 50%;
		background: var(--color-white);
		transition: transform var(--duration-base) var(--ease-out);
	}

	.switch[aria-checked="true"] { background: var(--color-ink); }
	.switch[aria-checked="true"] .switch__knob { transform: translateX(calc(var(--size-switch-width) - var(--size-switch-height))); }

	.switch:disabled {
		opacity: var(--opacity-disabled);
		cursor: default;
	}
</style>
