---
/*
 * Dropdown — a round button that opens a list (for example "Sort by").
 * Figma: Dropdown/Sort (8124:1146).
 *
 * Usage:
 *   <Dropdown icon={calendarIcon}>Sort by</Dropdown>
 *
 * Props:
 *   icon: imported 20 × 20 icon shown before the text (optional)
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import chevronIcon from '../../assets/icons/chevron-down.svg';

interface Props {
	icon?: ImageMetadata;
}

const { icon } = Astro.props;
---

<button class="dropdown" type="button" aria-haspopup="listbox">
	<span class="content">
		{icon && <Image src={icon} alt="" />}
		<span class="text-label-l-regular"><slot /></span>
	</span>
	<span class="chevron"><Image src={chevronIcon} alt="" /></span>
</button>

<style>
	.dropdown {
		display: inline-flex;
		align-items: center;
		flex-shrink: 0;
		gap: var(--space-8);
		padding: var(--space-14) var(--space-16);
		border: var(--border-width) solid var(--color-border-default);
		border-radius: var(--radius-999);
		background-color: var(--color-bg-surface);
		color: var(--color-text-primary);
		white-space: nowrap;
	}

	.dropdown:hover {
		border-color: var(--color-border-divider);
	}

	.content {
		display: inline-flex;
		align-items: center;
		gap: var(--space-4);
	}

	.chevron {
		display: inline-flex;
		padding: var(--space-4);
	}
</style>
