---
/* Скляний рядок статусу поверх «квітки»: подія ліворуч, позначка праворуч. dark: виділений. */
import Icon, { type IconName } from './Icon.astro';

interface Props {
	icon: IconName;
	label: string;
	variant?: 'glass' | 'dark';
}

const { icon, label, variant = 'glass' } = Astro.props;
---

<div class:list={['status', `status--${variant}`]}>
	<span class="status__label"><Icon name={icon} size={16} />{label}</span>
	<span class="status__mark"><slot /></span>
</div>

<style>
	.status {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-12);
		min-height: var(--size-row);
		padding-inline: var(--space-16) var(--space-12);
		border-radius: var(--radius-8);
		font-size: var(--font-size-14);
	}

	.status--glass {
		color: var(--color-ink);
		background: var(--color-bg-glass-soft);
		-webkit-backdrop-filter: blur(var(--blur-glass));
		backdrop-filter: blur(var(--blur-glass));
	}

	.status--dark { color: var(--color-dark-text); background: var(--color-dark-bg); }

	.status__label {
		display: flex;
		align-items: center;
		gap: var(--space-8);
		white-space: nowrap;
	}

	.status__mark {
		display: inline-flex;
		align-items: center;
		gap: var(--space-6);
		padding: var(--space-6) var(--space-8);
		border-radius: var(--radius-4);
		font-family: var(--font-family-mono);
		font-size: var(--font-size-11);
		font-weight: var(--font-weight-medium);
		line-height: var(--line-height-none);
		letter-spacing: var(--letter-spacing-caps);
		text-transform: uppercase;
		background: var(--color-bg-glass);
	}

	.status--dark .status__mark { background: var(--color-dark-surface); }
</style>
