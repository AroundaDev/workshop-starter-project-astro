---
/* Чип поверх фото чи картки. glass: напівпрозорий, solid: білий, dark: темний. */
interface Props {
	variant?: 'glass' | 'solid' | 'dark';
	mono?: boolean;
	class?: string;
}

const { variant = 'glass', mono = false, class: className } = Astro.props;
---

<span class:list={['chip', `chip--${variant}`, { 'chip--mono': mono }, className]}><slot /></span>

<style>
	.chip {
		display: inline-flex;
		align-items: center;
		gap: var(--space-8);
		height: var(--size-chip);
		padding-inline: var(--space-12);
		border-radius: var(--radius-999);
		font-size: var(--font-size-12);
		font-weight: var(--font-weight-medium);
		line-height: var(--line-height-none);
		white-space: nowrap;
	}

	.chip--glass {
		color: var(--color-ink);
		background: var(--color-bg-glass);
		-webkit-backdrop-filter: blur(var(--blur-glass));
		backdrop-filter: blur(var(--blur-glass));
	}

	.chip--solid { color: var(--color-ink); background: var(--color-white); }
	.chip--dark { color: var(--color-dark-text); background: var(--color-dark-bg); }

	.chip--mono {
		font-family: var(--font-family-mono);
		font-size: var(--font-size-11);
		letter-spacing: var(--letter-spacing-caps);
		text-transform: uppercase;
	}
</style>
