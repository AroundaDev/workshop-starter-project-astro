---
/* Смужка прогресу, value від 0 до 100. */
interface Props {
	label: string;
	value: number;
}

const { label, value } = Astro.props;
const safe = Math.min(100, Math.max(0, value));
---

<div class="progress" role="progressbar" aria-label={label} aria-valuenow={safe} aria-valuemin="0" aria-valuemax="100">
	<span class="progress__bar" style={`transform: scaleX(${safe / 100})`}></span>
</div>

<style>
	.progress {
		width: 100%;
		height: var(--size-progress);
		overflow: hidden;
		border-radius: var(--radius-2);
		background: var(--color-bg-surface);
	}

	.progress__bar {
		display: block;
		height: 100%;
		background: var(--color-text-primary);
		transform-origin: left;
		transition: transform var(--duration-base) var(--ease-soft);
	}
</style>
