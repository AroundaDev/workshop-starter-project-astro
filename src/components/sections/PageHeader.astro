---
/*
 * PageHeader — the greeting and headline, with search and sorting on the right.
 * Figma: Page Header (8131:64).
 * Phone and tablet: search and sorting go under the headline.
 *
 * Usage:
 *   <PageHeader welcome="Welcome back, Nik">
 *     5 new airlines <em>reports</em> available
 *   </PageHeader>
 * Words wrapped in <em> are shown in the light accent colour.
 */
import SearchField from '../ui/SearchField.astro';
import Dropdown from '../ui/Dropdown.astro';
import calendarIcon from '../../assets/icons/calendar.svg';

interface Props {
	welcome: string;
}

const { welcome } = Astro.props;
---

<div class="page-header">
	<div class="greeting">
		<p class="welcome text-heading-subtitle">{welcome}</p>
		<h2 class="headline text-heading-h1"><slot /></h2>
	</div>

	<div class="actions">
		<SearchField class="search" placeholder="Search" />
		<Dropdown icon={calendarIcon}>Sort by</Dropdown>
	</div>
</div>

<style>
	.page-header {
		display: flex;
		flex-direction: column;
		gap: var(--space-24);
	}

	.greeting {
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
	}

	.welcome {
		color: var(--color-text-muted);
	}

	.headline {
		color: var(--color-text-heading);
	}

	.headline :global(em) {
		font-style: normal;
		color: var(--color-text-muted);
	}

	.actions {
		display: flex;
		align-items: center;
		gap: var(--space-6);
	}

	.actions :global(.search) {
		flex: 1;
	}

	@media (min-width: 1024px) {
		.page-header {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
		}

		/* Figma: search field is 286px wide */
		.actions :global(.search) {
			flex: 0 1 calc(var(--space-40) * 7 + var(--space-6));
		}
	}
</style>
