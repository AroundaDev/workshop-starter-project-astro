---
/*
 * FeaturesSection — a heading plus a grid of cards.
 * 1 column on mobile, 2 on tablet, 3 on desktop.
 *
 * Usage:
 *   <FeaturesSection
 *     id="features"
 *     title="Why us"
 *     items={[{ title: 'Fast', text: '...' }, { title: 'Simple', text: '...' }]}
 *   />
 */
import Card from '../ui/Card.astro';

interface Props {
	id?: string;
	title: string;
	items: { title: string; text: string }[];
}

const { id, title, items } = Astro.props;
---

<section class="features" id={id}>
	<div class="container inner">
		<h2>{title}</h2>
		<div class="grid">
			{items.map((item) => <Card title={item.title}>{item.text}</Card>)}
		</div>
	</div>
</section>

<style>
	.features {
		padding-block: var(--space-2xl);
	}

	.inner {
		display: flex;
		flex-direction: column;
		gap: var(--space-xl);
	}

	.grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-md);
	}

	@media (min-width: 768px) {
		.grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1024px) {
		.features {
			padding-block: var(--space-3xl);
		}

		.grid {
			grid-template-columns: repeat(3, 1fr);
			gap: var(--space-lg);
		}
	}
</style>
