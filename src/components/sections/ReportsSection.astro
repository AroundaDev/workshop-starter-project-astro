---
/*
 * ReportsSection — "Reports" heading, filter tabs, "View all" button and the grid of report cards.
 * Figma: Reports (8131:65).
 * Cards: 1 column on phone, 2 on tablet and desktop, 3 on wide screens (1440px+).
 *
 * Usage:
 *   <ReportsSection title="Reports" tabs={[...]} reports={[...]} viewAllHref="/reports" />
 */
import FilterChip from '../ui/FilterChip.astro';
import Button from '../ui/Button.astro';
import ReportCard from '../ui/ReportCard.astro';

type Report = Parameters<typeof ReportCard>[0];

interface Props {
	title: string;
	tabs: { label: string; count?: number; active?: boolean }[];
	reports: Report[];
	viewAllHref?: string;
}

const { title, tabs, reports, viewAllHref = '#' } = Astro.props;
---

<section class="reports" aria-labelledby="reports-title">
	<div class="toolbar">
		<div class="heading">
			<h2 class="title text-heading-h2" id="reports-title">{title}</h2>
			<div class="tabs" role="group" aria-label="Report filters">
				{tabs.map((tab) => <FilterChip active={tab.active} count={tab.count}>{tab.label}</FilterChip>)}
			</div>
		</div>
		<Button href={viewAllHref} arrow>View all</Button>
	</div>

	<div class="grid">
		{reports.map((report) => <ReportCard {...report} />)}
	</div>
</section>

<style>
	.reports {
		display: flex;
		flex-direction: column;
		gap: var(--space-16);
	}

	.toolbar {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-16);
	}

	.heading {
		display: flex;
		flex-direction: column;
		gap: var(--space-16);
		inline-size: 100%;
		min-inline-size: 0;
	}

	.title {
		color: var(--color-text-heading);
	}

	/* On narrow screens the tabs scroll sideways inside their row */
	.tabs {
		display: flex;
		gap: var(--space-4);
		overflow-x: auto;
		scrollbar-width: none;
	}

	.grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-10);
	}

	@media (min-width: 768px) {
		.grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1024px) {
		.toolbar {
			flex-direction: row;
			align-items: flex-end;
			justify-content: space-between;
		}

		.heading {
			inline-size: auto;
		}
	}

	@media (min-width: 1440px) {
		.grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
