---
/*
 * HeroSection — the first, main block of a page.
 *
 * Usage:
 *   <HeroSection
 *     badge="New"
 *     title="Main headline"
 *     text="Short description"
 *     primaryLabel="Get started" primaryHref="/start"
 *     secondaryLabel="Learn more" secondaryHref="#features"
 *   />
 */
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';

interface Props {
	badge?: string;
	title: string;
	text?: string;
	primaryLabel?: string;
	primaryHref?: string;
	secondaryLabel?: string;
	secondaryHref?: string;
}

const { badge, title, text, primaryLabel, primaryHref, secondaryLabel, secondaryHref } = Astro.props;
---

<section class="hero">
	<div class="container inner">
		{badge && <Badge>{badge}</Badge>}
		<h1 class="title">{title}</h1>
		{text && <p class="text">{text}</p>}
		{(primaryLabel || secondaryLabel) && (
			<div class="actions">
				{primaryLabel && <Button href={primaryHref}>{primaryLabel}</Button>}
				{secondaryLabel && <Button variant="secondary" href={secondaryHref}>{secondaryLabel}</Button>}
			</div>
		)}
	</div>
</section>

<style>
	.hero {
		padding-block: var(--space-2xl);
	}

	.inner {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-md);
	}

	.text {
		max-width: 40ch;
		font-size: var(--font-size-lg);
		color: var(--color-text-muted);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm);
		margin-top: var(--space-xs);
	}

	@media (min-width: 1024px) {
		.hero {
			padding-block: var(--space-3xl);
		}

		.inner {
			align-items: center;
			text-align: center;
		}
	}
</style>
