---
/*
 * Sidebar — the narrow side menu of the dashboard.
 * Figma: Sidebar (8124:1076).
 * Phone: turns into a bar at the bottom of the screen with the main menu items only.
 * Tablet and larger: a 98px column on the left, as in Figma.
 *
 * Usage:
 *   <Sidebar active="dashboard" />
 *
 * Props:
 *   active: id of the current page's menu item
 */
import { Image } from 'astro:assets';
import NavItem from '../ui/NavItem.astro';
import IconButton from '../ui/IconButton.astro';
import brandLogo from '../../assets/logos/brand.svg';
import sidebarToggleIcon from '../../assets/icons/icon-button-sidebar-toggle.svg';
import dashboardIcon from '../../assets/icons/nav-dashboard.svg';
import reportsIcon from '../../assets/icons/nav-reports.svg';
import flightsIcon from '../../assets/icons/nav-flights.svg';
import supportIcon from '../../assets/icons/nav-support.svg';
import themeIcon from '../../assets/icons/nav-theme.svg';
import settingsIcon from '../../assets/icons/nav-settings.svg';
import logoutIcon from '../../assets/icons/nav-logout.svg';

interface Props {
	active?: string;
}

const { active = 'dashboard' } = Astro.props;

const menu = [
	{ id: 'dashboard', label: 'Dashboard', href: '/', icon: dashboardIcon },
	{ id: 'reports', label: 'Reports', href: '#', icon: reportsIcon },
	{ id: 'flights', label: 'Flights', href: '#', icon: flightsIcon },
	{ id: 'support', label: 'Support', href: '#', icon: supportIcon },
];

const others = [
	{ id: 'theme', label: 'Theme', href: '#', icon: themeIcon },
	{ id: 'settings', label: 'Settings', href: '#', icon: settingsIcon },
	{ id: 'logout', label: 'Log out', href: '#', icon: logoutIcon },
];
---

<aside class="sidebar">
	<div class="top">
		<div class="brand">
			<a class="logo" href="/" aria-label="Inflightfeed home">
				<Image src={brandLogo} alt="" />
			</a>
			<IconButton icon={sidebarToggleIcon} label="Collapse sidebar" />
		</div>

		<nav class="group" aria-labelledby="sidebar-menu">
			<p class="label text-caption-section-label" id="sidebar-menu">Menu</p>
			<ul class="items">
				{menu.map((item) => (
					<li>
						<NavItem href={item.href} icon={item.icon} label={item.label} variant={item.id === active ? 'active' : 'ghost'} />
					</li>
				))}
			</ul>
		</nav>
	</div>

	<nav class="group others" aria-labelledby="sidebar-others">
		<p class="label text-caption-section-label" id="sidebar-others">Others</p>
		<ul class="items">
			{others.map((item) => (
				<li>
					<NavItem href={item.href} icon={item.icon} label={item.label} variant="filled" />
				</li>
			))}
		</ul>
	</nav>
</aside>

<style>
	/* ---------- Phone: bottom bar ---------- */
	.sidebar {
		position: fixed;
		inset-inline: 0;
		inset-block-end: 0;
		z-index: 10;
		display: flex;
		justify-content: center;
		padding: var(--space-8) var(--space-16);
		border-block-start: var(--border-width) solid var(--color-border-topbar);
		background-color: var(--color-bg-subtle);
	}

	.brand,
	.label,
	.others {
		display: none;
	}

	.items {
		display: flex;
		gap: var(--space-10);
	}

	/* ---------- Tablet and larger: left column ---------- */
	@media (min-width: 768px) {
		.sidebar {
			position: sticky;
			inset-block-start: 0;
			flex-direction: column;
			align-items: center;
			justify-content: space-between;
			flex-shrink: 0;
			inline-size: var(--size-sidebar);
			block-size: 100vh;
			block-size: 100dvh;
			padding: var(--space-32) 0;
			overflow-y: auto;
			border-block-start: none;
		}

		.top {
			display: flex;
			flex-direction: column;
			align-items: center;
			/* Figma: 164px between the logo block and the menu */
			gap: calc(var(--space-40) * 4 + var(--space-4));
		}

		.brand {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: calc(var(--space-20) + var(--space-2));
		}

		.logo {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			inline-size: calc(var(--space-40) + var(--space-4));
			block-size: calc(var(--space-40) + var(--space-4));
			border-radius: var(--radius-10);
		}

		.group {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: var(--space-12);
		}

		.others {
			display: flex;
		}

		.label {
			display: block;
			padding-inline: var(--space-12);
			color: var(--color-text-caption);
			text-align: center;
		}

		.items {
			flex-direction: column;
		}
	}

	/* Short screens: less space above the menu so everything fits */
	@media (min-width: 768px) and (max-height: 900px) {
		.top {
			gap: var(--space-40);
		}
	}
</style>
